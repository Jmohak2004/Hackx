# Hardhat deployment only. Keep real keys in this untracked root .env file.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
OWNER_PRIVATE_KEY=
# Optional separate owner; defaults to the deploying wallet.
CONTRACT_OWNER=
# Use the server's evaluator address. It needs Sepolia ETH for gas.
AGENT_ADDRESS=
CREATE_ROUND=true
ROUND_STAKE_ETH=0.001
# Contract scale is 0–100: 10 means ±1 point in the UI.
ROUND_TOLERANCE=10
ROUND_DURATION_SECONDS=86400
ROUND_JUDGING_SECONDS=7200
