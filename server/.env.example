HOST=127.0.0.1
PORT=4000
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Set to 1 ONLY behind the trusted Next/reverse proxy.
TRUST_PROXY_HOPS=0
CHAIN_ID=11155111
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Required: address printed by contracts:deploy:sepolia, version 2.
GAME_CONTRACT_ADDRESS=
# Server-side evaluator key. Never prefix a private key with NEXT_PUBLIC_.
AGENT_PRIVATE_KEY=
# Persistent path: back up jobs and reports together. One API process per path.
DATA_DIR=./data
SCORING_API_URL=http://127.0.0.1:8000
GRAPHIFY_API_URL=http://127.0.0.1:4000
# Generate independent random tokens and share these two values with the scorer.
SCORING_API_TOKEN=
GRAPHIFY_INTERNAL_TOKEN=
# Optional read-only token: avoids the low unauthenticated GitHub API quota.
GITHUB_TOKEN=
# Optional: leave blank to use the built-in persistent JSON graph cache.
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
