GRAPHIFY_API_URL=http://127.0.0.1:4000
# Match the Node API values; secrets stay between these services.
SCORING_API_TOKEN=
GRAPHIFY_INTERNAL_TOKEN=
# Public websites only. The local stack sets this true for local test fixtures.
ALLOW_PRIVATE_TARGETS=false
# Optional creative commentary. Scores do not depend on this service.
NVIDIA_API_KEY=
# Optional system Chromium executable; otherwise uses Playwright's installation.
CHROME_PATH=
CHROME_NO_SANDBOX=false
